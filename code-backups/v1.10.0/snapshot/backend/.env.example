# ============================================
# PAYSICK ENVIRONMENT CONFIGURATION
# Banking-Grade Security Settings
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# IMPORTANT: Set to 'production' in production environments
# NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paysick_db
DB_USER=paysick_user
DB_PASSWORD=your_secure_password_here

# Vercel Postgres (Use for Vercel deployment)
# POSTGRES_URL=postgresql://neondb_owner:npg_T4R3IBjbXury@ep-summer-recipe-ah32v90p-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
# Automatically set by Vercel when you add Vercel Postgres

# ============================================
# SECURITY CONFIGURATION (REQUIRED IN PRODUCTION)
# ============================================

# Token Secret for Opaque Token Generation
# MUST be set in production - generate with: openssl rand -hex 64
# Application will FAIL TO START in production without this
TOKEN_SECRET=

# AES-256 Encryption Key for Sensitive Data (Banking Details)
# MUST be 32 bytes (64 hex characters) - generate with: openssl rand -hex 32
# Application will FAIL TO START in production without this
ENCRYPTION_KEY=

# ============================================
# CORS CONFIGURATION (REQUIRED IN PRODUCTION)
# ============================================

# Comma-separated list of allowed origins
# MUST be set in production - no wildcards allowed
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# ============================================
# RATE LIMITING
# ============================================

# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# EMAIL CONFIGURATION (Transactional Email)
# ============================================

# SMTP server (e.g. SendGrid, Mailgun, AWS SES, or your own server)
# If not set, development emails are sent via Ethereal (preview URL logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender details
# Use a monitored, repliable inbox — never "no-reply" (it lowers inbox trust and
# hurts deliverability). This should be an address you actually read, and the one
# Resend receives inbound replies on for the outreach agent.
SMTP_FROM=hello@paysick.co.za
SMTP_FROM_NAME=PaySick

# Public URL of the frontend (used to build verification links in emails)
# Set to your Vercel deployment URL in production
APP_URL=http://localhost:3000

# ============================================
# PROVIDER OUTREACH AGENT (daily pipeline)
# ============================================

# Public origin used for the "register as a provider" link in outreach copy.
# Prospects click these links, so a localhost APP_URL is ignored: this wins,
# then APP_URL when it is not localhost, then https://paysick.co.za.
PUBLIC_SITE_URL=https://paysick.co.za

# Google Places API key — sourcing + enrichment (Stages 1-2).
GOOGLE_PLACES_API_KEY=

# Anthropic API key — Claude drafting (Stage 3).
ANTHROPIC_API_KEY=

# Model string. Defaults to a current Sonnet-class model for cost/latency.
# Verify the current string at https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: only set if ANTHROPIC_MODEL points at a model that ACCEPTS a
# non-default temperature. Current Sonnet/Opus models reject it (400), so it is
# omitted from the request unless this is set.
# ANTHROPIC_TEMPERATURE=0.7

# Secret guarding the daily cron route (POST/GET /api/outreach/daily).
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# The daily brief reuses the SMTP_* settings above — no extra email config needed.

# Who receives the daily outreach brief (comma-separated). MUST be a real inbox
# you monitor — Resend sends mail but does NOT host mailboxes, so a made-up
# address hard-bounces. Set this to your actual inbox (e.g. your Google Workspace
# address or personal email).
BRIEF_RECIPIENTS=hello@paysick.co.za

# Resend inbound-reply webhook signing secret (whsec_...). Set this to the
# signing secret Resend shows when you add the webhook that points at
#   POST https://<your-domain>/api/outreach/inbound
# The endpoint verifies the Svix signature on every inbound reply. In production
# this is mandatory; if unset, unsigned inbound calls are rejected.
RESEND_WEBHOOK_SECRET=

# ============================================
# DEVELOPMENT ONLY - REMOVE IN PRODUCTION
# ============================================

# These are development defaults - NEVER use in production
# The application uses secure random values if these are not set in development

# ============================================
# GENERATING SECURE KEYS
# ============================================
#
# Generate TOKEN_SECRET:
#   openssl rand -hex 64
#
# Generate ENCRYPTION_KEY:
#   openssl rand -hex 32
#
# Example (DO NOT USE THESE VALUES):
#   TOKEN_SECRET=a1b2c3d4e5f6...
#   ENCRYPTION_KEY=1234567890abcdef...
#
# ============================================
